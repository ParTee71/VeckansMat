{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "veckansmat",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	// No database_id: wrangler finds the database by name, so the public repo
	// carries no account identifiers. CI creates it if it is missing.
	"d1_databases": [{ "binding": "DB", "database_name": "veckansmat" }],
	"env": {
		// Its own Worker (veckansmat-preview) and database, so that trying out main
		// never touches the household's data.
		"preview": {
			"d1_databases": [{ "binding": "DB", "database_name": "veckansmat-preview" }]
		}
	}
}
