{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "veckansmat",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_als"],
	// Wraps the Worker adapter-cloudflare builds (see wrangler.sveltekit.jsonc) with the cron.
	"main": "src/worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	// The week's offers, every ten minutes on Monday morning, one chain each run. Within the hours
	// Willys's robots.txt asks for. Inherited by env.preview. See docs/beslut/0023-erbjudanden.md.
	"triggers": { "crons": ["*/10 5 * * 1"] },
	"preview_urls": false,
	// Workers Logs keeps console.error from the app, such as why a call to Claude failed, so it can
	// be read in the dashboard afterwards. Inherited by env.preview.
	"observability": { "enabled": true },
	// No database_id: wrangler finds the database by name, so the public repo
	// carries no account identifiers. CI creates it if it is missing.
	"d1_databases": [{ "binding": "DB", "database_name": "veckansmat" }],
	// The key is a secret, ANTHROPIC_API_KEY, set on each Worker. See docs/beslut/0006-claude-i-appen.md.
	"vars": {
		"RECIPE_MODEL": "claude-haiku-5-5",
		"MENU_MODEL": "claude-sonnet-5-5",
		"SHOPPING_MODEL": "claude-haiku-5-5",
		"CATEGORY_MODEL": "claude-haiku-5-5",
		"CLAUDE_MONTHLY_LIMIT_USD": "5"
	},
	"env": {
		// Its own Worker (veckansmat-preview) and database, so that trying out main
		// never touches the household's data.
		"preview": {
			"d1_databases": [{ "binding": "DB", "database_name": "veckansmat-preview" }],
			// Not inherited from the top level, so repeated here.
			"vars": {
				"RECIPE_MODEL": "claude-haiku-5-5",
				"MENU_MODEL": "claude-sonnet-5-5",
				"SHOPPING_MODEL": "claude-haiku-5-5",
				"CATEGORY_MODEL": "claude-haiku-5-5",
				"CLAUDE_MONTHLY_LIMIT_USD": "5"
			}
		}
	}
}
