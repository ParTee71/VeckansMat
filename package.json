{
	"name": "veckansmat",
	"private": true,
	"version": "0.9.0",
	"description": "Veckomeny och inköpslista för hushållet",
	"type": "module",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "npm run db:migrate && vite dev",
		"build": "vite build",
		"preview": "npm run db:migrate && wrangler dev --port 4173",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"prepare": "npm run types && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"eval:recept": "vitest run --config evals/vitest.config.ts evals/recept",
		"eval:meny": "vitest run --config evals/vitest.config.ts evals/meny",
		"eval:handla": "vitest run --config evals/vitest.config.ts evals/handla",
		"eval:sort": "vitest run --config evals/vitest.config.ts evals/sort",
		"eval:erbjudanden": "vitest run --config evals/vitest.config.ts evals/erbjudanden",
		"verify": "npm run check && npm run lint && npm run test",
		"types": "wrangler types"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@cloudflare/puppeteer": "^1.4.0",
		"@m3e/web": "^2.10.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
