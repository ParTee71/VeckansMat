{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm ci)",
			"Bash(npm install)",
			"Bash(npm run verify)",
			"Bash(npm run check)",
			"Bash(npm run lint)",
			"Bash(npm run format)",
			"Bash(npm run build)",
			"Bash(npm test:*)",
			"Bash(npm run test:e2e:*)",
			"Bash(npx prettier:*)",
			"Bash(npx eslint:*)",
			"Bash(npx vitest:*)",
			"Bash(npx playwright test:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)"
		],
		"ask": ["Bash(npx wrangler deploy:*)", "Bash(npx wrangler d1 execute:* --remote:*)"],
		"deny": [
			"Read(./.dev.vars)",
			"Read(./.dev.vars.*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(npx wrangler secret:*)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.mjs",
						"timeout": 300
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(git push:*)",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-push.mjs",
						"timeout": 300
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.mjs",
						"timeout": 60
					}
				]
			}
		]
	}
}
